# Chỉ chứa tên biến, giá trị để trống. KHÔNG điền khóa thật vào file này.
# Cloudflare Pages: đặt các biến dưới dạng Secret/Variable trong Settings → Variables and Secrets.
# Chạy local bằng `npx wrangler pages dev dist`: đặt vào file .dev.vars (đã nằm trong .gitignore).

# Bắt buộc: khóa API Anthropic (dùng chung cho các nhân vật)
ANTHROPIC_API_KEY=

# Bắt buộc nếu dùng Sai (Sai chạy bằng Google Gemini): khóa tạo ở Google AI Studio, KHÔNG phải gói Google AI Pro/Gemini Advanced.
# Thiếu thì chỉ Sai báo "chưa cấu hình".
GEMINI_API_KEY=

# Chỉ cần nếu đổi nhân vật nào đó sang OpenAI trong functions/_lib/config.js (hiện chưa nhân vật nào dùng)
OPENAI_API_KEY=

# Tùy chọn: đổi model cho từng nhân vật; chỉ nhận model của đúng nhà cung cấp nhân vật đó
#   Anthropic: claude-haiku-5-5, claude-sonnet-5-5, claude-opus-5-5, claude-fable-5-1
#   Google (Sai): gemini-3.8-flash, gemini-3.6-flash, gemini-3.5-flash-lite, gemini-4-argon
MODEL_NARUTO=
MODEL_SHIKAMARU=
MODEL_JIRAIYA=
MODEL_SAI=
MODEL_NEJI=
MODEL_MINATO=
MODEL_INO=

# Tùy chọn: múi giờ cho lịch đề xuất của Minato (mặc định Asia/Ho_Chi_Minh)
TIMEZONE=

# Tùy chọn: số lượt gọi AI tối đa cho mỗi IP trong 10 phút (mặc định 40)
RATE_LIMIT_PER_10MIN=
