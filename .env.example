# Chỉ chứa tên biến, giá trị để trống. KHÔNG điền khóa thật vào file này.
# Cloudflare Pages: đặt các biến dưới dạng Secret/Variable trong Settings → Variables and Secrets (Production), rồi deploy lại.
# Chạy local bằng `npx wrangler pages dev dist`: đặt vào file .dev.vars (đã nằm trong .gitignore).

# Bắt buộc: khóa CheapKeyAI (cổng bên thứ ba, ẩn danh: nội dung đi qua máy chủ của họ; không dùng với dữ liệu nhạy cảm).
# Cả 7 nhân vật mặc định dùng khóa này với model gpt-5-mini.
CHEAPKEY_API_KEY=

# Tùy chọn: chuyển một nhân vật sang provider khác, ví dụ PROVIDER_SAI=google. Giá trị hợp lệ: cheapkey, anthropic, google, openai.
# Model phải thuộc đúng provider (MODEL_<TÊN>):
#   cheapkey: gpt-5-mini
#   anthropic: claude-haiku-5-5, claude-sonnet-5-5, claude-opus-5-5, claude-fable-5-1
#   google: gemini-3.8-flash, gemini-3.6-flash, gemini-3.5-flash-lite, gemini-4-argon
#   openai: gpt-6.1-sol
PROVIDER_NARUTO=
PROVIDER_SHIKAMARU=
PROVIDER_JIRAIYA=
PROVIDER_SAI=
PROVIDER_NEJI=
PROVIDER_MINATO=
PROVIDER_INO=
MODEL_NARUTO=
MODEL_SHIKAMARU=
MODEL_JIRAIYA=
MODEL_SAI=
MODEL_NEJI=
MODEL_MINATO=
MODEL_INO=

# Chỉ cần khi chuyển nhân vật sang provider tương ứng (khóa tạo ở Google AI Studio / console của hãng, không phải gói chat trả phí)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Tùy chọn: tạo ảnh cho Sai (dùng chung CHEAPKEY_API_KEY). Model hợp lệ: gpt-image-1. Giới hạn ảnh mỗi IP trong 10 phút (mặc định 10).
IMAGE_MODEL=
IMAGE_RATE_LIMIT_PER_10MIN=

# Tùy chọn: múi giờ cho lịch đề xuất của Minato (mặc định Asia/Ho_Chi_Minh)
TIMEZONE=

# Tùy chọn: số lượt gọi AI tối đa cho mỗi IP trong 10 phút (mặc định 40)
RATE_LIMIT_PER_10MIN=
